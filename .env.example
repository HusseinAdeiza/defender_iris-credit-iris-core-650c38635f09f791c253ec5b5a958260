export API_KEY_ALCHEMY="YOUR_ALCHEMY_API_KEY"
export VNET_RPC_URL="YOUR_VNET_RPC_URL"

# Scripts (script/scriptMaster.sh)
export PRIVATE_KEY="0x..."            # deployer key (omit when USE_LEDGER=true)
export ETH_FROM="0x..."               # sender address; required when USE_LEDGER=true
export USE_LEDGER="false"             # true = sign with a Ledger instead of PRIVATE_KEY
export VERIFY="false"                 # true = verify on Etherscan (needs [etherscan] config)